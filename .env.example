# Environment Variables untuk EduAdmin
# Copy file ini ke .env.local dan isi dengan nilai yang sesuai

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google Gemini API Key untuk fitur AI (opsional)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# SECURITY: Kontrol apakah fallback (login lokal/legacy) diizinkan.
# Pada production set ke false: VITE_ALLOW_FALLBACK_AUTH=false
VITE_ALLOW_FALLBACK_AUTH=false

# Port untuk development server (opsional, default 3000)
PORT=3000

# Environment mode
NODE_ENV=development